// Jenkinsfile - Declarative CI/CD Automation Pipeline
// Stack: Java 21 LTS · Playwright Java · TestNG · Maven · Docker Compose

pipeline {
    agent any

    parameters {
        choice(name: 'SUITE', choices: ['suites/regression.xml', 'suites/smoke.xml', 'suites/api.xml', 'suites/ui.xml', 'suites/db.xml', 'suites/nfr.xml', 'suites/a11y.xml'], description: 'TestNG Suite XML file to execute')
        choice(name: 'BROWSER', choices: ['chromium', 'firefox', 'webkit'], description: 'Browser family for UI test execution')
        booleanParam(name: 'HEADLESS', defaultValue: true, description: 'Run browser in headless mode')
        booleanParam(name: 'ENABLE_TREND_HISTORY', defaultValue: true, description: 'Persist Allure report trend history across CI builds')
        string(name: 'THREAD_COUNT', defaultValue: '2', description: 'Parallel execution thread count across test classes')
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk-amd64'
        MAVEN_HOME = '/usr/share/maven'
        PATH = "/usr/lib/jvm/java-21-openjdk-amd64/bin:/usr/share/maven/bin:${env.PATH}"
        PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = '0'
        BASE_URL = 'http://host.docker.internal:5000'
        ADMIN_URL = 'http://host.docker.internal:5000/Admin'
        DB_HOST = 'host.docker.internal'
        TEST_ENV_NAME = 'jenkins-ci-docker'
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        ansiColor('xterm')
    }

    stages {
        stage('Checkout & Toolchain Verification') {
            steps {
                echo "=== Checkout Repository & Toolchain Verification ==="
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Validate Required Jenkins Secrets') {
            steps {
                echo "=== Verifying Required Secret Bindings in Jenkins Credentials Store ==="
                withCredentials([
                    string(credentialsId: 'nop-admin-email', variable: 'ADMIN_EMAIL'),
                    string(credentialsId: 'nop-admin-password', variable: 'ADMIN_PASSWORD'),
                    string(credentialsId: 'nop-db-user', variable: 'DB_USER'),
                    string(credentialsId: 'nop-db-password', variable: 'DB_PASSWORD')
                ]) {
                    sh '''
                        set -e
                        [ -n "${ADMIN_EMAIL:-}" ] || { echo "ERROR: Missing required secret nop-admin-email (ADMIN_EMAIL)." >&2; exit 1; }
                        [ -n "${ADMIN_PASSWORD:-}" ] || { echo "ERROR: Missing required secret nop-admin-password (ADMIN_PASSWORD)." >&2; exit 1; }
                        [ -n "${DB_USER:-}" ] || { echo "ERROR: Missing required secret nop-db-user (DB_USER)." >&2; exit 1; }
                        [ -n "${DB_PASSWORD:-}" ] || { echo "ERROR: Missing required secret nop-db-password (DB_PASSWORD)." >&2; exit 1; }
                        echo "All required Jenkins secrets validated."
                    '''
                }
            }
        }

        stage('AUT Environment Verification') {
            steps {
                echo "=== Verifying Isolated nopCommerce AUT Readiness at ${env.BASE_URL} ==="
                sh '''
                    set -e
                    case "${BASE_URL}" in
                        *demo.nopcommerce.com*)
                            echo "ERROR: Public demo site is forbidden as a test target (${BASE_URL})." >&2
                            exit 1
                            ;;
                    esac
                    for i in $(seq 1 30); do
                        if curl -s -f "${BASE_URL}/" > /dev/null; then
                            echo "AUT is active and responding on ${BASE_URL}"
                            exit 0
                        fi
                        sleep 5
                    done
                    echo "ERROR: Timed out waiting for isolated AUT on ${BASE_URL}" >&2
                    exit 1
                '''
            }
        }

        stage('Playwright Driver Setup') {
            steps {
                echo "=== Ensuring Playwright Browser Binaries & System Dependencies ==="
                sh "mvn exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args=\"install ${params.BROWSER}\" || mvn exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args=\"install --with-deps ${params.BROWSER}\" || true"
            }
        }

        stage('Restore Allure Trend History') {
            when {
                expression { return params.ENABLE_TREND_HISTORY }
            }
            steps {
                sh '''
                    mkdir -p target/allure-results
                    if [ -d "${JENKINS_HOME}/allure-history/${JOB_NAME}/history" ]; then
                        cp -r "${JENKINS_HOME}/allure-history/${JOB_NAME}/history" target/allure-results/history
                        echo "Restored Allure trend history from previous CI build."
                    fi
                '''
            }
        }

        stage('Execute Test Suite') {
            steps {
                echo "=== Running Suite: ${params.SUITE} | Browser: ${params.BROWSER} | Headless: ${params.HEADLESS} | Threads: ${params.THREAD_COUNT} ==="
                withCredentials([
                    string(credentialsId: 'nop-admin-email', variable: 'ADMIN_EMAIL'),
                    string(credentialsId: 'nop-admin-password', variable: 'ADMIN_PASSWORD'),
                    string(credentialsId: 'nop-db-user', variable: 'DB_USER'),
                    string(credentialsId: 'nop-db-password', variable: 'DB_PASSWORD')
                ]) {
                    sh '''
                        mvn clean test \
                            -DsuiteFile="src/test/resources/${SUITE}" \
                            -DsuiteXmlFile="src/test/resources/${SUITE}" \
                            -DbrowserName="${BROWSER}" \
                            -Dheadless="${HEADLESS}" \
                            -DthreadCount="${THREAD_COUNT}" \
                            -DbaseUrl="${BASE_URL}" \
                            -DadminUrl="${ADMIN_URL}" \
                            -DdbHost="${DB_HOST}" \
                            -DadminEmail="${ADMIN_EMAIL}" \
                            -DadminPassword="${ADMIN_PASSWORD}" \
                            -DdbUser="${DB_USER}" \
                            -DdbPassword="${DB_PASSWORD}"
                    '''
                }
            }
        }

        stage('RTM Traceability Matrix Sync') {
            steps {
                echo "=== Running RTM Reconciliation Script ==="
                sh 'python3 scripts/reconcile_rtm.py'
            }
        }
    }

    post {
        always {
            echo "=== Archiving Test Artifacts and Generating Allure Reports ==="
            archiveArtifacts artifacts: 'target/surefire-reports/**/*, evidence/reports/**/*, evidence/failures/**/*, target/allure-results/**/*', allowEmptyArchive: true

            script {
                try {
                    sh 'mvn allure:report || true'
                    archiveArtifacts artifacts: 'target/site/allure-maven-plugin/**/*', allowEmptyArchive: true
                } catch (Throwable t) {
                    echo "Notice: Maven allure:report generation skipped or failed: ${t.message}"
                }

                try {
                    allure includeProperties: false, jdk: '', results: [[path: 'target/allure-results']]
                    if (params.ENABLE_TREND_HISTORY) {
                        sh '''
                            if [ -d "allure-report/history" ]; then
                                mkdir -p "${JENKINS_HOME}/allure-history/${JOB_NAME}"
                                cp -r allure-report/history "${JENKINS_HOME}/allure-history/${JOB_NAME}/"
                            fi
                        '''
                    }
                } catch (Throwable t) {
                    echo "Notice: Allure Plugin step skipped or not installed: ${t.message}"
                }
            }
        }
        success {
            echo "Jenkins Automation Build SUCCEEDED!"
        }
        failure {
            echo "Jenkins Automation Build FAILED. Check test output & evidence artifacts."
        }
    }
}
