// Jenkinsfile - Declarative CI/CD Automation Pipeline
// Stack: Java 21 LTS · Playwright Java · TestNG · Maven · Docker Compose

def runWithToolchain(String cmd) {
    sh """
        if [ -d /usr/lib/jvm/java-21-openjdk-amd64 ]; then
            export JAVA_HOME='/usr/lib/jvm/java-21-openjdk-amd64'
            export PATH="\${JAVA_HOME}/bin:\${PATH}"
        fi
        if [ -d /usr/share/maven/bin ]; then
            export PATH="/usr/share/maven/bin:\${PATH}"
        fi
        ${cmd}
    """
}

pipeline {
    agent any

    parameters {
        choice(name: 'SUITE', choices: ['suites/regression.xml', 'suites/smoke.xml', 'suites/api.xml', 'suites/ui.xml', 'suites/db.xml', 'suites/nfr.xml', 'suites/a11y.xml'], description: 'TestNG Suite XML file to execute')
        choice(name: 'BROWSER', choices: ['chromium', 'firefox', 'webkit'], description: 'Browser family for UI test execution')
        booleanParam(name: 'HEADLESS', defaultValue: true, description: 'Run browser in headless mode')
        booleanParam(name: 'ENABLE_TREND_HISTORY', defaultValue: true, description: 'Persist Allure report trend history across CI builds')
        string(name: 'THREAD_COUNT', defaultValue: '2', description: 'Parallel execution thread count across test classes')
    }

    environment {
        PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = '0'
        BASE_URL = 'http://nopcommerce_web'
        ADMIN_URL = 'http://nopcommerce_web/Admin'
        DB_HOST = 'nopcommerce_database'
        TEST_ENV_NAME = 'jenkins-ci-docker'
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        ansiColor('xterm')
    }

    stages {
        stage('Checkout & Toolchain Verification') {
            steps {
                echo "=== Checkout Repository & Toolchain Verification ==="
                sh '''
                    rm -rf target/surefire-reports target/a11y-reports target/allure-results target/site \
                           evidence/failures/* evidence/traces/* evidence/reports/* \
                           evidence/surefire-reports/*.dumpstream reports .ci || true
                '''
                script {
                    runWithToolchain('java -version && mvn -version')
                }
            }
        }

        stage('Validate Required Jenkins Secrets') {
            steps {
                echo "=== Verifying Required Secret Bindings in Jenkins Credentials Store ==="
                withCredentials([
                    string(credentialsId: 'nop-admin-email', variable: 'ADMIN_EMAIL'),
                    string(credentialsId: 'nop-admin-password', variable: 'ADMIN_PASSWORD'),
                    string(credentialsId: 'nop-db-user', variable: 'DB_USER'),
                    string(credentialsId: 'nop-db-password', variable: 'DB_PASSWORD')
                ]) {
                    sh '''
                        set -e
                        [ -n "${ADMIN_EMAIL:-}" ] || { echo "ERROR: Missing required secret nop-admin-email (ADMIN_EMAIL)." >&2; exit 1; }
                        [ -n "${ADMIN_PASSWORD:-}" ] || { echo "ERROR: Missing required secret nop-admin-password (ADMIN_PASSWORD)." >&2; exit 1; }
                        [ -n "${DB_USER:-}" ] || { echo "ERROR: Missing required secret nop-db-user (DB_USER)." >&2; exit 1; }
                        [ -n "${DB_PASSWORD:-}" ] || { echo "ERROR: Missing required secret nop-db-password (DB_PASSWORD)." >&2; exit 1; }
                        echo "All required Jenkins secrets validated."
                    '''
                }
            }
        }

        stage('AUT Environment Verification') {
            steps {
                echo "=== Verifying Isolated nopCommerce AUT Readiness at ${env.BASE_URL} ==="
                sh '''
                    set -e
                    case "${BASE_URL}" in
                        *demo.nopcommerce.com*)
                            echo "ERROR: Public demo site is forbidden as a test target (${BASE_URL})." >&2
                            exit 1
                            ;;
                    esac
                    for i in $(seq 1 30); do
                        if curl -fsSL "${BASE_URL}/" 2>/dev/null | grep -qi "small-searchterms"; then
                            echo "AUT is active and responding on ${BASE_URL}"
                            exit 0
                        fi
                        sleep 5
                    done
                    echo "ERROR: Timed out waiting for isolated AUT on ${BASE_URL}" >&2
                    exit 1
                '''
            }
        }

        stage('Playwright Driver Setup') {
            steps {
                echo "=== Ensuring Playwright Browser Binaries & System Dependencies ==="
                withEnv(["PW_BROWSER=${params.BROWSER}"]) {
                    script {
                        runWithToolchain('''
                            if [ "$(id -u)" -eq 0 ] || (command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null); then
                                mvn exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install --with-deps ${PW_BROWSER}"
                            else
                                echo "Notice: Running as unprivileged user without passwordless sudo; installing Playwright browser binary only (skipping --with-deps)."
                                mvn exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install ${PW_BROWSER}"
                            fi
                        ''')
                    }
                }
            }
        }

        stage('Restore Allure Trend History') {
            when {
                expression { return params.ENABLE_TREND_HISTORY }
            }
            steps {
                sh '''
                    rm -rf .ci/allure-history
                    if [ -d "${JENKINS_HOME}/allure-history/${JOB_NAME}/history" ]; then
                        mkdir -p .ci/allure-history
                        cp -r "${JENKINS_HOME}/allure-history/${JOB_NAME}/history" .ci/allure-history/history
                        echo "Restored Allure trend history from previous CI build."
                    fi
                '''
            }
        }

        stage('Execute Test Suite') {
            steps {
                echo "=== Running Suite: ${params.SUITE} | Browser: ${params.BROWSER} | Headless: ${params.HEADLESS} | Threads: ${params.THREAD_COUNT} ==="
                withCredentials([
                    string(credentialsId: 'nop-admin-email', variable: 'ADMIN_EMAIL'),
                    string(credentialsId: 'nop-admin-password', variable: 'ADMIN_PASSWORD'),
                    string(credentialsId: 'nop-db-user', variable: 'DB_USER'),
                    string(credentialsId: 'nop-db-password', variable: 'DB_PASSWORD')
                ]) {
                    script {
                        runWithToolchain('''
                            rm -rf evidence/failures/* evidence/traces/* evidence/reports/* || true
                            mvn clean test \
                                -DsuiteFile="src/test/resources/${SUITE}" \
                                -DsuiteXmlFile="src/test/resources/${SUITE}" \
                                -Dbrowser="${BROWSER}" \
                                -Dheadless="${HEADLESS}" \
                                -DthreadCount="${THREAD_COUNT}" \
                                -DbaseUrl="${BASE_URL}" \
                                -DadminUrl="${ADMIN_URL}" \
                                -DdbHost="${DB_HOST}"
                        ''')
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (fileExists('target/surefire-reports/testng-results.xml')) {
                    echo "=== Running RTM Traceability Verification ==="
                    sh 'python3 scripts/reconcile_rtm.py --verify-only'
                } else {
                    echo "Notice: Skipping RTM Traceability Verification because target/surefire-reports/testng-results.xml was not generated in this build."
                }

                if (fileExists('target/surefire-reports/TEST-TestSuite.xml')) {
                    try {
                        junit allowEmptyResults: true, testResults: 'target/surefire-reports/TEST-TestSuite.xml'
                    } catch (Throwable t) {
                        echo "Notice: JUnit report step skipped or failed: ${t.message}"
                    }
                }

                if (params.ENABLE_TREND_HISTORY && fileExists('target/allure-results') && fileExists('.ci/allure-history/history')) {
                    sh '''
                        mkdir -p target/allure-results/history
                        cp -r .ci/allure-history/history/. target/allure-results/history/
                        echo "Copied Allure trend history into the current results after Maven clean."
                    '''
                }
            }
            echo "=== Archiving Test Artifacts and Generating Allure Reports ==="
            archiveArtifacts artifacts: 'target/surefire-reports/**/*, target/a11y-reports/**/*, evidence/a11y/**/*, evidence/failures/**/*, evidence/traces/**/*, target/allure-results/**/*, docs/*.md', allowEmptyArchive: true

            script {
                if (fileExists('target/allure-results')) {
                    try {
                        runWithToolchain('mvn allure:report || true')
                        archiveArtifacts artifacts: 'target/site/allure-maven-plugin/**/*', allowEmptyArchive: true
                    } catch (Throwable t) {
                        echo "Notice: Maven allure:report generation skipped or failed: ${t.message}"
                    }

                    boolean pluginHistorySaved = false
                    try {
                        allure includeProperties: false, jdk: '', results: [[path: 'target/allure-results']]
                        if (params.ENABLE_TREND_HISTORY && currentBuild.result != 'ABORTED') {
                            sh '''
                                if [ -d "allure-report/history" ]; then
                                    rm -rf "${JENKINS_HOME}/allure-history/${JOB_NAME}/history"
                                    mkdir -p "${JENKINS_HOME}/allure-history/${JOB_NAME}"
                                    cp -r allure-report/history "${JENKINS_HOME}/allure-history/${JOB_NAME}/"
                                fi
                            '''
                            pluginHistorySaved = true
                        }
                    } catch (Throwable t) {
                        echo "Notice: Allure Plugin step skipped or not installed: ${t.message}"
                    }

                    if (!pluginHistorySaved && params.ENABLE_TREND_HISTORY && currentBuild.result != 'ABORTED') {
                        sh '''
                            if [ -d "target/site/allure-maven-plugin/history" ]; then
                                rm -rf "${JENKINS_HOME}/allure-history/${JOB_NAME}/history"
                                mkdir -p "${JENKINS_HOME}/allure-history/${JOB_NAME}"
                                cp -r target/site/allure-maven-plugin/history "${JENKINS_HOME}/allure-history/${JOB_NAME}/"
                            fi
                        '''
                    }
                } else {
                    echo "Notice: Skipping Allure report generation because target/allure-results was not generated in this build."
                }
            }
        }
        success {
            echo "Jenkins Automation Build SUCCEEDED!"
        }
        failure {
            echo "Jenkins Automation Build FAILED. Check test output & evidence artifacts."
        }
    }
}
