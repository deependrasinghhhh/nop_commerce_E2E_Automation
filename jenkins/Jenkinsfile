// Jenkinsfile - Declarative CI/CD Automation Pipeline
// Stack: Java 21 LTS · Playwright Java · TestNG · Maven · Docker Compose

pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['container', 'demo_fallback'], description: 'Execution target environment')
        choice(name: 'SUITE', choices: ['suites/api.xml', 'suites/smoke.xml', 'suites/regression.xml', 'suites/ui.xml', 'suites/db.xml'], description: 'TestNG Suite XML to execute')
        choice(name: 'BROWSER', choices: ['chromium', 'firefox', 'webkit'], description: 'Browser family for UI tests')
        booleanParam(name: 'HEADLESS', defaultValue: true, description: 'Run browser in headless mode')
        string(name: 'THREAD_COUNT', defaultValue: '2', description: 'Parallel execution thread count')
    }

    environment {
        JAVA_HOME = tool name: 'Java-21', type: 'jdk'
        MAVEN_HOME = tool name: 'Maven-3.9', type: 'maven'
        PATH = "${env.JAVA_HOME}/bin:${env.MAVEN_HOME}/bin:${env.PATH}"
        PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = '0'
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        ansiColor('xterm')
    }

    stages {
        stage('Checkout & Environment Setup') {
            steps {
                echo "=== Checkout Repository & Toolchain Setup ==="
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Container Lifecycle Startup') {
            when {
                expression { return params.ENVIRONMENT == 'container' }
            }
            steps {
                echo "=== Launching Containerized nopCommerce 4.90.8 + MSSQL 2022 ==="
                dir('docker') {
                    sh 'docker compose down -v || true'
                    sh 'docker compose up -d'
                }
                echo "=== Awaiting AUT Readiness via Healthcheck Probe ==="
                timeout(time: 5, unit: 'MINUTES') {
                    sh '''
                        until curl -s -f http://localhost:5000/ > /dev/null; do
                            echo "Awaiting nopCommerce container on port 5000..."
                            sleep 10
                        done
                        echo "nopCommerce AUT is ready on http://localhost:5000"
                    '''
                }
            }
        }

        stage('Playwright Driver Installation') {
            steps {
                echo "=== Verifying and Installing Playwright Browser Binaries ==="
                sh 'mvn exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install --with-deps chromium"'
            }
        }

        stage('Execute Test Suite') {
            steps {
                echo "=== Running Suite: ${params.SUITE} | Browser: ${params.BROWSER} | Headless: ${params.HEADLESS} ==="
                sh """
                    mvn clean test \
                        -DsuiteFile=src/test/resources/${params.SUITE} \
                        -Dbrowser=${params.BROWSER} \
                        -Dheadless=${params.HEADLESS} \
                        -Ddataproviderthreadcount=${params.THREAD_COUNT}
                """
            }
        }

        stage('RTM Traceability Reconciliation') {
            steps {
                echo "=== Running Machine RTM Reconciliation Script ==="
                sh 'python scripts/reconcile_rtm.py || python3 scripts/reconcile_rtm.py'
            }
        }
    }

    post {
        always {
            echo "=== Archiving Test Results & Machine Evidence ==="
            // Archive JUnit / Surefire XML test reports
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'

            // Publish TestNG HTML reports
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'target/surefire-reports',
                reportFiles: 'index.html',
                reportName: 'TestNG Execution Report'
            ])

            // Archive failure screenshots and trace files
            archiveArtifacts allowEmptyArchive: true, artifacts: 'evidence/failures/**', fingerprint: true
            archiveArtifacts allowEmptyArchive: true, artifacts: 'evidence/reports/**', fingerprint: true
            archiveArtifacts allowEmptyArchive: true, artifacts: 'docs/traceability-matrix.md, docs/execution-summary.md'
        }

        cleanup {
            script {
                if (params.ENVIRONMENT == 'container') {
                    echo "=== Tearing Down Docker Container Environment ==="
                    dir('docker') {
                        sh 'docker compose down -v || true'
                    }
                }
            }
        }

        failure {
            echo "Pipeline failed. Review evidence artifacts in the build archive for screenshots and traces."
        }
    }
}
