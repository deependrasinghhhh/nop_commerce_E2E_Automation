# ==============================================================================
# nopCommerce QA Automation Environment Variables
# Copy this file to .env and adjust values for your local execution
# ==============================================================================

# Application Base URLs
# Use local docker instance (default) or public demo fallback
BASE_URL=http://localhost:5000
ADMIN_URL=http://localhost:5000/Admin

# Execution Browser Configuration (chromium | firefox | webkit)
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=10000

# Administrative Credentials
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=Admin@12345

# Database Configuration (Microsoft SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=nopcommerce_db
DB_USER=sa
DB_PASSWORD=NopCommerce@2026!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Evidence and Reporting
RECORD_VIDEO=false
RECORD_TRACE=true
CAPTURE_SCREENSHOT_ON_FAILURE=true
