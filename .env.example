# ==============================================================================
# nopCommerce QA Automation – Environment Variables Template
# Copy this file to .env and set your actual values locally, or inject via
# GitHub Actions Secrets / Jenkins Credentials Store in CI.
# NEVER commit the .env file; it is git-ignored.
# ==============================================================================

# Application Base URLs (Must point to an isolated test instance, never the public demo)
BASE_URL=http://127.0.0.1:5000
ADMIN_URL=http://127.0.0.1:5000/Admin

# Execution Browser Configuration (chromium | firefox | webkit | chrome | msedge)
BROWSER=chromium
BROWSER_CHANNEL=none
BROWSER_ARGS=
CDP_URL=none
HEADLESS=true
IGNORE_HTTPS_ERRORS=false
SLOW_MO=0
DEFAULT_TIMEOUT=45000

# Administrative Credentials (REQUIRED for Admin & authenticated suites – no default fallback)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database Configuration (Microsoft SQL Server – REQUIRED for DB & Docker suites – no default fallback)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=nopcommerce_db
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Evidence, Allure Metadata, and Reporting
RECORD_VIDEO=false
RECORD_TRACE=true
CAPTURE_SCREENSHOT_ON_FAILURE=true
ALLURE_TREND_HISTORY=true
TEST_ENV_NAME=local-docker
