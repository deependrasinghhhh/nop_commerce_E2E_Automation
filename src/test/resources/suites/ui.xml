<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="nopCommerce Storefront UI Suite">
    <listeners>
        <listener class-name="com.qa.nopcommerce.listeners.TestListener" />
    </listeners>

    <test name="Storefront UI Tests" parallel="classes" thread-count="2">
        <classes>
            <class name="com.qa.nopcommerce.tests.ui.AuthTest" />
            <class name="com.qa.nopcommerce.tests.ui.CatalogTest" />
            <class name="com.qa.nopcommerce.tests.ui.CartTest" />
            <class name="com.qa.nopcommerce.tests.ui.CheckoutTest" />
            <class name="com.qa.nopcommerce.tests.ui.CustomerAccountTest" />
            <class name="com.qa.nopcommerce.tests.ui.AdminTest" />
        </classes>
    </test>
</suite>
