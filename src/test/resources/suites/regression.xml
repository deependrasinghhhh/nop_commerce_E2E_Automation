<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="nopCommerce Full Regression Suite" parallel="none">
    <listeners>
        <listener class-name="com.qa.nopcommerce.listeners.TestListener" />
    </listeners>

    <test name="API Endpoint Integration Tests" parallel="none">
        <classes>
            <class name="com.qa.nopcommerce.tests.api.ApiEndpointTest" />
        </classes>
    </test>

    <test name="Storefront UI Tests" parallel="none">
        <classes>
            <class name="com.qa.nopcommerce.tests.ui.AuthTest" />
            <class name="com.qa.nopcommerce.tests.ui.CatalogTest" />
            <class name="com.qa.nopcommerce.tests.ui.CartTest" />
            <class name="com.qa.nopcommerce.tests.ui.CheckoutTest" />
            <class name="com.qa.nopcommerce.tests.ui.CustomerAccountTest" />
            <class name="com.qa.nopcommerce.tests.ui.AdminTest" />
        </classes>
    </test>

    <test name="Accessibility Compliance Tests" parallel="none">
        <classes>
            <class name="com.qa.nopcommerce.tests.a11y.AccessibilityTest" />
        </classes>
    </test>

    <test name="Database Persistence Verification Tests" parallel="none">
        <classes>
            <class name="com.qa.nopcommerce.tests.db.DatabaseVerificationTest" />
        </classes>
    </test>

    <test name="Non-Functional Responsive and SLA Tests" parallel="none">
        <classes>
            <class name="com.qa.nopcommerce.tests.nfr.NonFunctionalTest" />
        </classes>
    </test>
</suite>
